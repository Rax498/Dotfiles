# i3 config file (v4)
# Reference: https://i3wm.org/docs/userguide.html
#
# KEYBINDING PATTERN  (Super = $mod). The modifier tells you what a key does:
#   Super         go to something / main action  focus h j k l, workspaces 1-0, close w
#   Super+Shift   MOVE it                        move h j k l, send to workspace 1-0
#   Super+Alt     reshape the LAYOUT             h v split, w tabbed, s stacking, e toggle split
#   Super+Ctrl    SYSTEM / session               l lock, k shortcut help, t performance monitor
# Directions are always h j k l (left down up right); arrow keys do the same as a backup.

# Border configuration
set $thick 2

# DEFAULT BORDER
for_window [class="^.*"] border none
for_window [title="^.*"] border none
for_window [class="Eww"] border none
for_window [class="conky"] border none

# APPLICATION BORDERS
for_window [class="Emacs"] border pixel $thick
for_window [class="URxvt"] border pixel $thick
for_window [class="st"] border pixel $thick

workspace_auto_back_and_forth no
focus_follows_mouse yes
smart_borders on
smart_borders no_gaps

# FLOATING APPLICATIONS
for_window [instance="FL64.exe"] floating enable
for_window [instance="explorer.exe"] floating enable
for_window [class="Wine"] floating enable
for_window [class="Blueman-manager"] floating enable
for_window [class="gwenview"] floating enable, sticky enable, resize set 960 540, move position center
for_window [class="haruna"] floating enable, resize set 1090 615, move position center
for_window [class="mpv"] floating enable, resize set 1090 615, move position center
for_window [class="ark"] floating enable, resize set 890 500, move position center
for_window [class="Xdg-desktop-portal-gtk"] floating enable, resize set 890 500, move position center
for_window [class="com-abdownloadmanager-desktop-AppKt"] floating enable, move position center
for_window [class="copyq"] floating enable, resize set 550 410, move position center
for_window [class="Audacious"] floating enable, resize set 550 410, move position center
for_window [class="Virt-manager" title="on QEMU/KVM"] resize set 1000
set $mod Mod4

# colours: generated by tinty (see client-colors.conf)
include ~/.config/i3/colors.conf

gaps inner 4
gaps outer 0
gaps top 32   
gaps bottom 0

# PROTIP: You can also dynamically set dmenu's colors this way:
bindsym $mod+d exec ~/.config/rofi/launchers/type-6/launcher.sh

# Show Keybindings Help
bindsym $mod+Ctrl+k exec ~/.config/i3/i3-help.sh

# Workspace cycling with looping
bindsym Ctrl+Mod4+Right exec --no-startup-id ~/.config/Scripts/ws_cycle.sh next
bindsym Ctrl+Mod4+Left exec --no-startup-id ~/.config/Scripts/ws_cycle.sh prev

# Locker
bindsym $mod+Ctrl+l exec --no-startup-id lock

# Pulse Audio controls
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5% && ~/.config/eww/scripts/volume-popup.sh
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5% && ~/.config/eww/scripts/volume-popup.sh
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && ~/.config/eww/scripts/volume-popup.sh
bindsym XF86AudioPause exec --no-startup-id playerctl play-pause
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous
bindsym XF86AudioStop exec --no-startup-id playerctl stop

bindsym XF86MonBrightnessUp exec --no-startup-id ~/.config/i3/brightness.sh up && ~/.config/eww/scripts/brightness-popup.sh
bindsym XF86MonBrightnessDown exec --no-startup-id ~/.config/i3/brightness.sh down && ~/.config/eww/scripts/brightness-popup.sh

# Font for window titles and tab headers. Its size sets the header height.
font pango:JetBrainsMono Nerd Font 9

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# start a terminal
bindsym $mod+Shift+Return exec DRI_PRIME=1 alacritty 
bindsym $mod+Return exec alacritty

# start file manager
bindsym $mod+Shift+f exec nemo

# Browser binding
# bindsym $mod+Shift+Return exec firefox
bindsym $mod+b exec zen

# start powermenu
bindsym $mod+Shift+e exec ~/.config/rofi/powermenu/type-5/powermenu.sh

# Omarchy-style additions
bindsym $mod+Escape exec ~/.config/rofi/powermenu/type-5/powermenu.sh
bindsym $mod+Mod1+space exec ~/.config/eww/scripts/toggle-panel.sh start_menu
bindsym $mod+Ctrl+t exec eww open --toggle performance_monitor

# show / hide the top bar (and the space reserved for it)
bindsym $mod+z exec --no-startup-id ~/.config/eww/scripts/toggle-bar.sh

# start wpg
bindsym $mod+Shift+b exec ~/.config/rofi/wpg-select.sh

# colour scheme picker (tinty)
bindsym $mod+Shift+t exec ~/.config/rofi/theme-select.sh

# Full screenshot
bindsym --release Print exec scrot ~/Pictures/Screenshots/screenshot_%Y%m%d_%H%M%S.png

# Area selection
bindsym --release $mod+Shift+s exec scrot -s ~/Pictures/Screenshots/screenshot_%Y%m%d_%H%M%S.png

# Area selection → clipboard
bindsym --release $mod+Ctrl+Shift+s exec scrot -s /tmp/screenshot.png && xclip -selection clipboard -t image/png -i /tmp/screenshot.png

# close focused window
bindsym $mod+w kill

# focus: h j k l (arrows as backup). In a tabbed container h / l switch tabs,
# in a stacked one j / k switch windows.
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move the focused window (or tab): Shift + the same keys
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# scratchpad: show it / move the window into it
bindsym $mod+minus scratchpad show
bindsym $mod+Shift+minus move scratchpad

# layout of the focused container: Alt + i3's stock layout keys
bindsym $mod+Mod1+h split h
bindsym $mod+Mod1+v split v
bindsym $mod+Mod1+w layout tabbed
bindsym $mod+Mod1+s layout stacking
bindsym $mod+Mod1+e layout toggle split

# Omarchy-style shortcut: one key toggles tabs on / off (same as the Alt keys above)
bindsym $mod+g layout toggle tabbed split

# focus the parent container
bindsym $mod+a focus parent

# Define names for default workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# toggle tiling / floating (any number of windows can float)
bindsym $mod+t floating toggle
bindsym $mod+Shift+space floating toggle

# switch focus between the floating and the tiling windows (i3 default key)
bindsym $mod+space focus mode_toggle
bindsym $mod+Shift+v floating toggle, resize set 500 300, move position center

# Switch to workspace
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10

# reload the configuration file
bindsym $mod+Shift+c reload

# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart

# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
        bindsym h resize shrink width 5 px or 5 ppt
        bindsym j resize grow height 5 px or 5 ppt
        bindsym k resize shrink height 5 px or 5 ppt
        bindsym l resize grow width 5 px or 5 ppt

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape or $mod+r
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# Voice Control Mode
mode "voice" {
    bindsym Return mode "default"; exec --no-startup-id pkill -f bridge.sh; exec --no-startup-id pkill voicewm; exec --no-startup-id dunstctl close 999
    bindsym Escape mode "default"; exec --no-startup-id pkill -f bridge.sh; exec --no-startup-id pkill voicewm; exec --no-startup-id dunstctl close 999
}

# Trigger untuk masuk mode (Mod+M)
bindsym $mod+m mode "voice"; exec --no-startup-id ~/.config/eww/scripts/bridge.sh

# Set screen timeout
exec --no-startup-id xset s 600 600

# Auto lock dengan xss-lock
exec --no-startup-id xss-lock -- lock

exec --no-startup-id kbuildsycoca6 --noincremental
exec --no-startup-id /usr/bin/kded6

exec --no-startup-id joystickwake

# Jalankan semua aplikasi autostart
exec --no-startup-id dex --autostart --environment i3

# Autostart
exec_always --no-startup-id ~/.config/i3/autostart.sh
